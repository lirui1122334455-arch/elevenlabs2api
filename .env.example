# Optional environment overrides for local / Compose demos.
# Copy to .env and fill in values. Never commit a real .env.

# Host port for the console
# ELEVENLABS_CONSOLE_PORT=18000

# Self-built console image
# ELEVENLABS_CONSOLE_IMAGE=elevenlabs-console-local:latest

# Path to runtime config (keep secrets only in this local file)
# ELEVENLABS_CONSOLE_CONFIG=./config.yaml

# ELEVENLABS_CONSOLE_NO_PROXY=127.0.0.1,localhost,console,elevenlabs-gateway,elevenlabs-register

# ElevenLabs development gateway (keep real keys only in local .env)
# ELEVENLABS_GATEWAY_PORT=18092
# ELEVENLABS_GATEWAY_URL=http://elevenlabs-gateway:8092
# ELEVENLABS_API_KEY=
# ELEVENLABS_GATEWAY_KEY=
# ELEVENLABS_API_BASE_URL=https://api.us.elevenlabs.io
# ELEVENLABS_PROXY_URL=
# ELEVENLABS_PUBLIC_BASE_URL=http://127.0.0.1:18092
# ELEVENLABS_MAX_CONCURRENT=1
# ELEVENLABS_GENERATION_TIMEOUT=240
# ELEVENLABS_REGISTER_PORT=18093
# ELEVENLABS_REGISTER_URL=http://elevenlabs-register:8093
# ELEVENLABS_REGISTER_KEY=

# Host-side ElevenLabs registration CLI (do not put real keys in git)
# YYDS_API_KEY=
# ELEVENLABS_MAIL_DOMAINS=
# YESCAPTCHA_API_KEY=

TZ=Asia/Shanghai
