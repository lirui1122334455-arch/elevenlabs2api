FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ELEVENLABS_REGISTER_HOST=0.0.0.0 \
    ELEVENLABS_REGISTER_PORT=8093 \
    ELEVENLABS_RUNTIME_CONFIG_PATH=/app/data/runtime-config.json \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY services/auto_register/requirements.txt services/auto_register/requirements-elevenlabs.txt ./
RUN pip install --no-cache-dir -r requirements-elevenlabs.txt && \
    python -m playwright install --with-deps chromium

COPY services/auto_register/protocol_register.py ./
COPY services/auto_register/engine ./engine
COPY services/auto_register/elevenlabs_assisted ./elevenlabs_assisted
COPY services/auto_register/elevenlabs_server.py ./
COPY services/elevenlabs_gateway/runtime_config.py ./

RUN mkdir -p /app/data && chmod 700 /app/data

EXPOSE 8093
CMD ["python", "elevenlabs_server.py"]
