{
  "provider": "elevenlabs",
  "proxy": {
    "url": "",
    "api_url": "",
    "require_proxy": false,
    "preflight_url": "https://elevenlabs.io/app/sign-up",
    "connect_timeout_sec": 15
  },
  "browser": {
    "headless": false,
    "channel": "chrome",
    "unique_profile": true,
    "profile_dir": "./data/elevenlabs-profile",
    "navigation_timeout_sec": 60,
    "user_confirmation_timeout_sec": 180
  },
  "captcha": {
    "api_key": "${YESCAPTCHA_API_KEY}",
    "endpoint": "https://api.yescaptcha.com",
    "timeout_sec": 180
  },
  "mail": {
    "provider": "yyds",
    "yyds_api_base": "https://maliapi.215.im/v1",
    "yyds_api_key": "${YYDS_API_KEY}",
    "mailDomains": "${ELEVENLABS_MAIL_DOMAINS}",
    "email_proxy": "same_as_browser",
    "timeout_sec": 180,
    "mail_poll_interval": 2,
    "allowed_verification_hosts": [
      "elevenlabs.io",
      "*.elevenlabs.io",
      "elevenlabs.firebaseapp.com"
    ]
  },
  "account": {
    "email": "auto",
    "password": "auto",
    "save_credentials": true,
    "credentials_file": "./data/elevenlabs-credentials.json"
  }
}
